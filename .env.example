# Copy to .env (ignored by Git). Secrets stay server-side; never use VITE_ prefixes.
AI_PROVIDER=openrouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY is preferred; existing OPENAI_API_KEY also works with OpenRouter.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Preserve a model available to your account; JSON is validated even without Structured Outputs.
OPENAI_MODEL=poolside/laguna-s-2.1:free
# OpenRouter generation budget (includes reasoning); one truncated response retries
# from scratch with double this budget, capped at 32000, within the total deadline.
AI_MAX_OUTPUT_TOKENS=16000
# OpenRouter: low reduces reasoning overhead; none omits the effort parameter.
AI_REASONING_EFFORT=low
API_PORT=8787
# For OpenAI directly: AI_PROVIDER=openai, OPENAI_BASE_URL=https://api.openai.com/v1,
# OPENAI_API_KEY and an OpenAI model supporting Responses web search / Structured Outputs.

# NaraRouter: AI_PROVIDER=nararouter, OPENAI_BASE_URL=https://router.bynara.id/v1,
# OPENAI_API_KEY=<your Nara key>, OPENAI_MODEL=<your Nara model alias>.
# Optional actual web research for Nara; absent/unavailable search uses model knowledge,
# with no citations and an explicit warning. Never put this key in VITE_ variables.
EXA_API_KEY=
